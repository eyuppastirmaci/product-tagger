# Copy to .env and adjust. Defaults work out of the box for local development.

# --- Postgres ---
POSTGRES_DB=product_tagger
POSTGRES_USER=pt
POSTGRES_PASSWORD=pt
POSTGRES_PORT=5432

# --- RabbitMQ ---
RABBITMQ_USER=pt
RABBITMQ_PASSWORD=pt
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- MinIO (object storage) ---
# MinIO requires: user >= 3 chars, password >= 8 chars
MINIO_USER=pt-admin
MINIO_PASSWORD=pt-password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=product-images

# --- AI (hosted profile) ---
HF_TOKEN=
HF_MODEL=Qwen/Qwen3.5-27B
HF_PROVIDER=novita

# --- AI (local profile, requires: docker compose --profile local-ai up) ---
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen3.5:4b

# --- Backend ---
SPRING_PROFILES_ACTIVE=hosted
# JWT signing secret, at least 32 chars; generate one with: openssl rand -base64 48
JWT_SECRET=

# --- App (full stack: docker compose up) ---
# Host port the web app is served on
APP_PORT=80
